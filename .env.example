# Скопируйте в .env.local и подставьте свой ключ, чтобы включить реальные ответы Claude.
# Без ключа приложение работает в демо-режиме (умный mock на данных обучения бота).
ANTHROPIC_API_KEY=

# Необязательно: модель по умолчанию для реальных ответов
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ОБЯЗАТЕЛЬНО для приёма сообщений Telegram: публичный HTTPS-адрес сервиса
# (за Nginx/Caddy, порт 443 → localhost:3000). Из него строится webhook.
# ВАЖНО: это должен быть домен с валидным SSL, а НЕ http://IP:3000 —
# Telegram принимает только https на портах 443/80/88/8443.
WEBHOOK_BASE_URL=https://api.домен.ru
